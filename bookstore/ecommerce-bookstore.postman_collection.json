{
  "info": {
    "name": "eCommerce Bookstore API",
    "_postman_id": "ecommerce-bookstore-collection",
    "description": "Complete Postman collection for the Spring Boot eCommerce Bookstore API running on http://localhost:8081",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",  "value": "http://localhost:8081",  "type": "string" },
    { "key": "token",    "value": "",                       "type": "string" },
    { "key": "userId",   "value": "",                       "type": "string" },
    { "key": "bookId",   "value": "",                       "type": "string" },
    { "key": "cartItemId", "value": "",                     "type": "string" },
    { "key": "orderId",  "value": "",                       "type": "string" },
    { "key": "addressId","value": "",                       "type": "string" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.accessToken) { pm.collectionVariables.set('token', res.accessToken); }",
                  "if (res.user && res.user.userId) { pm.collectionVariables.set('userId', res.user.userId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Pass@1234\",\n  \"phone\": \"+91-9000000001\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.accessToken) { pm.collectionVariables.set('token', res.accessToken); }",
                  "if (res.user && res.user.userId) { pm.collectionVariables.set('userId', res.user.userId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@bookstore.com\",\n  \"password\": \"Demo@1234\"\n}"
            }
          }
        },
        {
          "name": "Login (Demo User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.accessToken) { pm.collectionVariables.set('token', res.accessToken); }",
                  "if (res.user && res.user.userId) { pm.collectionVariables.set('userId', res.user.userId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@bookstore.com\",\n  \"password\": \"Demo@1234\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Catalog",
      "item": [
        {
          "name": "List All Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api","books"],
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search Books by Keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?search=focus&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api","books"],
              "query": [
                { "key": "search",   "value": "focus" },
                { "key": "page",     "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Filter Books by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?category=self-help&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api","books"],
              "query": [
                { "key": "category", "value": "self-help" },
                { "key": "page",     "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Filter Books by Format",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?format=Paperback&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api","books"],
              "query": [
                { "key": "format",   "value": "Paperback" },
                { "key": "page",     "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Filter Books by Price Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?minPrice=100&maxPrice=400&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api","books"],
              "query": [
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "400" },
                { "key": "page",     "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Bestsellers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books/bestsellers?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api","books","bestsellers"],
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get New Launches",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books/new-launches?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api","books","new-launches"],
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Book by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.bookId) { pm.collectionVariables.set('bookId', res.bookId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","books","{{bookId}}"]
            }
          }
        },
        {
          "name": "Get Related Books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}/related?pageSize=5",
              "host": ["{{baseUrl}}"],
              "path": ["api","books","{{bookId}}","related"],
              "query": [
                { "key": "pageSize", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "List All Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api","categories"]
            }
          }
        }
      ]
    },

    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/cart/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","cart","{{userId}}"]
            }
          }
        },
        {
          "name": "Add Item to Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.items && res.items.length > 0) { pm.collectionVariables.set('cartItemId', res.items[0].itemId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cart/{{userId}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["api","cart","{{userId}}","items"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"quantity\": 1,\n  \"format\": \"Paperback\"\n}"
            }
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cart/{{userId}}/items/{{cartItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","cart","{{userId}}","items","{{cartItemId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "Remove Item from Cart",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/cart/{{userId}}/items/{{cartItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","cart","{{userId}}","items","{{cartItemId}}"]
            }
          }
        }
      ]
    },

    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order (Checkout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.orderId) { pm.collectionVariables.set('orderId', res.orderId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api","orders"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryAddressId\": \"{{addressId}}\",\n  \"paymentMethod\": \"UPI\",\n  \"appliedCouponCode\": null,\n  \"redeemedGiftPoints\": 0\n}"
            }
          }
        },
        {
          "name": "Get Order History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/orders/user/{{userId}}?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api","orders","user","{{userId}}"],
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","orders","{{orderId}}"]
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api","orders","{{orderId}}","cancel"]
            }
          }
        }
      ]
    },

    {
      "name": "Payments",
      "item": [
        {
          "name": "Process Payment – UPI",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/process",
              "host": ["{{baseUrl}}"],
              "path": ["api","payments","process"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentMethod\": \"UPI\",\n  \"amount\": 399.00,\n  \"currency\": \"INR\",\n  \"upiId\": \"john@upi\"\n}"
            }
          }
        },
        {
          "name": "Process Payment – Credit Card",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/process",
              "host": ["{{baseUrl}}"],
              "path": ["api","payments","process"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentMethod\": \"CreditCard\",\n  \"amount\": 399.00,\n  \"currency\": \"INR\",\n  \"cardNumber\": \"4111111111111111\",\n  \"cardHolderName\": \"John Doe\",\n  \"expiryMonth\": 12,\n  \"expiryYear\": 2027,\n  \"cvv\": \"123\"\n}"
            }
          }
        },
        {
          "name": "Process Payment – Wallet",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/process",
              "host": ["{{baseUrl}}"],
              "path": ["api","payments","process"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentMethod\": \"Wallet\",\n  \"amount\": 399.00,\n  \"currency\": \"INR\",\n  \"walletProvider\": \"Paytm\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Shipping",
      "item": [
        {
          "name": "Estimate Shipping – Free (above threshold)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/shipping/estimate?pinCode=400001&orderValue=500",
              "host": ["{{baseUrl}}"],
              "path": ["api","shipping","estimate"],
              "query": [
                { "key": "pinCode",    "value": "400001" },
                { "key": "orderValue", "value": "500" }
              ]
            }
          }
        },
        {
          "name": "Estimate Shipping – Charged (below threshold)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/shipping/estimate?pinCode=400001&orderValue=30",
              "host": ["{{baseUrl}}"],
              "path": ["api","shipping","estimate"],
              "query": [
                { "key": "pinCode",    "value": "400001" },
                { "key": "orderValue", "value": "30" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "Users",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","users","{{userId}}"]
            }
          }
        },
        {
          "name": "Get User Addresses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (Array.isArray(res) && res.length > 0) { pm.collectionVariables.set('addressId', res[0].addressId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["api","users","{{userId}}","addresses"]
            }
          }
        },
        {
          "name": "Add Address",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.addressId) { pm.collectionVariables.set('addressId', res.addressId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["api","users","{{userId}}","addresses"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstLine\": \"12 MG Road\",\n  \"secondLine\": \"Floor 3\",\n  \"city\": \"Bangalore\",\n  \"state\": \"Karnataka\",\n  \"country\": \"India\",\n  \"pinCode\": \"560001\",\n  \"isDefault\": false\n}"
            }
          }
        }
      ]
    }

  ]
}
